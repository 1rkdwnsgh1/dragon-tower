s; 새 드래곤을 만� '_'로 시작하는 폴더는 게임이 읽지 않습니다. 복사한 뒤 이름에서 '_'를 빼세요.
; 자세한 규격: docs/character-pipeline.md

[dragon]
name=새 드래곤
role=미정
desc=한 줄 설명을 적으세요.
color=FF9AA2B4      ; RRGGBB 또는 AARRGGBB

; 1레벨 기준값
hp=110
atk=11
def=4
speed=170
dodge=0.30          ; 0 ~ 0.75
regen=0             ; 초당 체력 회복

; 레벨당 증가량
hp_growth=15
atk_growth=2.4
def_growth=0.8
dodge_growth=0
regen_growth=0

; flip=no 로 두면 왼쪽을 볼 때도 좌우 반전하지 않습니다(왼쪽용 시트를 따로 둘 때).
flip=yes

; ---- 애니메이션 ----
; 같은 폴더의 idle.png / move.png / attack.png / hit.png / death.png / fly.png 를 읽습니다.
; 가로 한 줄 시트이며, frame_w 는 칸 너비입니다(기본: 이미지 높이와 같은 정사각형).
; 파일이 없는 상태는 idle 로 대신 그립니다. idle 도 없으면 임시 도형으로 그립니다.
[anim.idle]
fps=8
loop=yes
frame_w=256

[anim.move]
fps=10
loop=yes
frame_w=256

[anim.attack]
fps=12
loop=no
frame_w=256

; 바탕화면에서 스스로 날 때 쓴다. 없으면 move, 그것도 없으면 idle 로 그려진다.
[anim.fly]
fps=10
loop=yes
frame_w=256
; render_scale: 이 상태만 크게/작게 그린다(0.25~4). 원본 그림이 상태마다
; 다른 크기로 그려졌을 때만 쓴다. 바닥 기준선은 유지된다.
;render_scale=1.0

; ---- 스킬 ----
; kind: Projectile(유도탄) Burst(주변 원형) Line(직선) Dash(돌진)
;       Heal(회복) Shield(피해 감소) Haste(이동·회피 상승) Zone(지속 피해 장판)
[skill.1]
name=스킬 1
desc=가장 가까운 적을 공격한다.
kind=Projectile
level=1
cooldown=4
power=1.9           ; 공격력 배수
range=370

[skill.2]
name=스킬 2
desc=주변 적에게 피해를 준다.
kind=Burst
level=3
cooldown=8
power=1.6
radius=110

[skill.3]
name=스킬 3
desc=앞쪽 일직선에 피해를 준다.
kind=Line
level=6
cooldown=10
power=2.6
radius=36           ; Line 은 반폭
range=320
